# =============================================================================
#  L'Âme Du Tambour — variables d'environnement
#  Ce fichier est ignoré par git (.gitignore ligne 34). Ne jamais le committer.
#  Toute variable ajoutée ici doit l'être aussi, à vide, dans .env.example.
# =============================================================================

# --- Identité ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_DESCRIPTION=""
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# --- Base de données ---------------------------------------------------------
# ⚠️  BASE DE DÉVELOPPEMENT UNIQUEMENT.
#     `npm run seed` et `prisma migrate reset` DÉTRUISENT le contenu de la base
#     pointée ici. Ne jamais y mettre l'URL de production.
#     Neon → projet → branche `dev` → Connection string → Pooled connection.
DATABASE_URL=""

# Même serveur, point d'entrée direct (sans -pooler) : requis par prisma migrate,
# qui passe mal à travers PgBouncer.
DIRECT_URL=""

# --- Authentification --------------------------------------------------------
# À générer : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# Signe les jetons de l'app mobile (POST /api/auth/login, validité 30 jours).
# Changer cette valeur invalide tous les jetons mobiles déjà émis.
JWT_SECRET=""

# --- Paiement ----------------------------------------------------------------
# Le parsing est `split(", ")` : la virgule DOIT être suivie d'une espace.
PAYMENT_METHODS="Stripe, Transfer"
DEFAULT_PAYMENT_METHOD="Stripe"

# Stripe en mode test (clés `sk_test_` / `pk_test_`). Requis en phase 02.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` fournit le whsec_.
STRIPE_WEBHOOK_SECRET=""

# PayPal — inutilisé tant que "PayPal" n'est pas dans PAYMENT_METHODS (phase 03).
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_APP_SECRET=""

# --- Emails transactionnels (Resend) -----------------------------------------
# Requis en phase 02 : accusé de commande + formulaire de contact.
# Sans domaine vérifié, SENDER_EMAIL doit rester onboarding@resend.dev.
RESEND_API_KEY=""
SENDER_EMAIL="onboarding@resend.dev"

# --- Envoi d'images (UploadThing) --------------------------------------------
# Requis en phase 04 : images produits, visuels et bannières d'articles.
UPLOADTHING_TOKEN=""

# --- Réglages applicatifs ----------------------------------------------------
# Le défaut codé en dur dans lib/constants vaut 2 : à corriger en phase 02.
PAGE_SIZE="12"
LATEST_PRODUCTS_LIMIT="4"
# Parsing `split(", ")`, même règle que PAYMENT_METHODS.
USER_ROLES="admin, user"
